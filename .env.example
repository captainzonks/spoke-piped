# ==============================================================================
# PIPED MODULE - ENVIRONMENT VARIABLES
# ==============================================================================
# Description: Module-specific environment defaults for spoke-piped
# Author: Matt Barham
# Created: 2026-04-25
# Modified: 2026-04-25
# Version: 1.0.0
# Host: Your Server
# ==============================================================================
# Type: Template
# Security Level: MEDIUM - Contains internal IPs and service endpoints
# Component: module: piped
# ==============================================================================
# Note: This file provides module defaults. Hub base.env variables are merged
#       automatically by Spoke. Site-specific overrides go in modules.yml.
# ==============================================================================

#### IMAGES

# Piped backend (Java). 'azul-zulu' is the upstream rolling tag - pin a digest in
# modules.yml env_overrides for reproducible deployments.
PIPED_IMAGE=1337kavin/piped:azul-zulu

# Piped frontend (static SPA). Upstream only ships :latest.
PIPED_FRONTEND_IMAGE=1337kavin/piped-frontend:latest

# Piped ytproxy (Rust). Upstream only ships :latest.
PIPED_PROXY_IMAGE=1337kavin/piped-proxy:latest

# bg-helper-server (PoToken provider). Upstream only ships :latest.
PIPED_BG_HELPER_IMAGE=1337kavin/bg-helper-server:latest

# Module-local Postgres. pgautoupgrade handles major version migrations.
# PG18 baseline matches the Spoke hub convention; image is fully external so the
# module stays standalone (no dependency on hub-built postgres image).
PIPED_POSTGRES_IMAGE=pgautoupgrade/pgautoupgrade:18-alpine

#### NETWORK

PIPED_FRONTEND_IP=192.168.35.26
PIPED_BACKEND_IP=192.168.35.27
PIPED_PROXY_IP=192.168.35.28
PIPED_BG_HELPER_IP=192.168.35.29
PIPED_POSTGRES_IP=192.168.35.30

#### HOSTNAMES

# Subdomain prefixes are substituted into Traefik routers at deploy time by
# Spoke's deploy_traefik_rules.sh (>= 1.3.0). Override via modules.yml
# env_overrides if you want a different brand (e.g. tube/tubeapi/tubeproxy).
PIPED_FRONTEND_SUBDOMAIN=piped
PIPED_API_SUBDOMAIN=pipedapi
PIPED_PROXY_SUBDOMAIN=pipedproxy

# Full hostnames (consumed by docker-compose and config.properties). Derived
# from the subdomain vars above.
PIPED_FRONTEND_HOSTNAME=${PIPED_FRONTEND_SUBDOMAIN}.${DOMAIN}
PIPED_API_HOSTNAME=${PIPED_API_SUBDOMAIN}.${DOMAIN}
PIPED_PROXY_HOSTNAME=${PIPED_PROXY_SUBDOMAIN}.${DOMAIN}

#### POSTGRES

PIPED_POSTGRES_DB=piped
PIPED_POSTGRES_USER=piped

#### DATA PATHS

PIPED_DIR=${APPDATA_DIR}/piped
