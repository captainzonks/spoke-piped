# ==============================================================================
# PIPED-BACKEND - config.properties (TEMPLATE)
# ==============================================================================
# Description: Default Piped backend configuration. Copy to ${PIPED_DIR}/config/
#              and edit before deploying. Hostnames must match the Traefik
#              router hosts (piped., pipedapi., pipedproxy. on your DOMAIN).
# Reference:   https://github.com/TeamPiped/Piped-Docker/blob/main/template/config.properties
# ==============================================================================

# The port to Listen on.
PORT:8080
HTTP_WORKERS:2

# Public URLs - REPLACE example.org with your DOMAIN
API_URL:https://pipedapi.example.org
FRONTEND_URL:https://piped.example.org
PROXY_PART:https://pipedproxy.example.org

# Proxy hash secret - must match piped-proxy HASH_SECRET (read from secret file)
# Leave commented to disable URL signing; uncomment and inject via env if used.
#PROXY_HASH_SECRET:INSERT_HERE

# Captcha (Capmonster) - optional, only needed for federated registration
CAPTCHA_BASE_URL:https://api.capmonster.cloud/
CAPTCHA_API_KEY:INSERT_HERE

# Account / feature toggles
COMPROMISED_PASSWORD_CHECK:true
DISABLE_REGISTRATION:false
FEED_RETENTION:30
DISABLE_TIMERS:false
DISABLE_RYD:false
DISABLE_SERVER:false
DISABLE_LBRY:false
SUBSCRIPTIONS_EXPIRY:30
CONSENT_COOKIE:true

# RYD + SponsorBlock
RYD_PROXY_URL:https://ryd-proxy.kavin.rocks
SPONSORBLOCK_SERVERS:https://sponsor.ajay.app,https://sponsorblock.kavin.rocks

# Matrix federation (optional, anon mode if MATRIX_TOKEN omitted)
MATRIX_SERVER:https://matrix-client.matrix.org
#MATRIX_TOKEN:INSERT_HERE

# bg-helper for PoTokens (uncomment to enable, in-stack service)
#BG_HELPER_URL:http://piped-bg-helper:8080

# Geo restriction federation (optional)
#GEO_RESTRICTION_CHECKER_URL:INSERT_HERE

# Sentry error tracking (optional)
#SENTRY_DSN:INSERT_HERE

# S3-compatible object storage (optional)
#S3_ENDPOINT:INSERT_HERE
#S3_ACCESS_KEY:INSERT_HERE
#S3_SECRET_KEY:INSERT_HERE
#S3_BUCKET:INSERT_HERE

# Hibernate / Postgres - hostname matches piped-postgres container_name
hibernate.connection.url:jdbc:postgresql://piped-postgres:5432/piped
hibernate.connection.driver_class:org.postgresql.Driver
hibernate.dialect:org.hibernate.dialect.PostgreSQLDialect
hibernate.connection.username:piped
# REPLACE before deployment - must match contents of
# ${SECRETS_DIR}/piped/piped_postgres_password
hibernate.connection.password:CHANGEME_BEFORE_DEPLOY

# Frontend extras (optional)
#frontend.statusPageUrl:https://status.example.org
#frontend.donationUrl:https://example.org/donate
