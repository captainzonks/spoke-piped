# ==============================================================================
# PIPED MODULE - ENVIRONMENT VARIABLES
# ==============================================================================
# Description: Module-specific environment defaults for spoke-piped
# Author: Matt Barham
# Created: 2026-04-25
# Modified: 2026-04-25
# Version: 1.0.0
# Host: Your Server
# ==============================================================================
# Type: Template
# Security Level: MEDIUM - Contains internal IPs and service endpoints
# Component: module: piped
# ==============================================================================
# Note: This file provides module defaults. Hub base.env variables are merged
#       automatically by Spoke. Site-specific overrides go in modules.yml.
# ==============================================================================

#### IMAGES

# Piped backend (Java). 'azul-zulu' is the upstream rolling tag - pin a digest in
# modules.yml env_overrides for reproducible deployments.
PIPED_IMAGE=1337kavin/piped:azul-zulu

# Piped frontend (static SPA). Upstream only ships :latest, so pinned by
# amd64 digest instead for reproducibility. Re-pin periodically:
# `docker pull 1337kavin/piped-frontend:latest && docker inspect --format='{{index .RepoDigests 0}}' 1337kavin/piped-frontend:latest`
PIPED_FRONTEND_IMAGE=1337kavin/piped-frontend@sha256:d2699b1cc3383b1a6a557dc23c83b13fe17b5d2acc199178699a87dc4adc1de3

# Piped ytproxy (Rust). Upstream only ships :latest, so pinned by amd64
# digest instead for reproducibility. Re-pin periodically:
# `docker pull 1337kavin/piped-proxy:latest && docker inspect --format='{{index .RepoDigests 0}}' 1337kavin/piped-proxy:latest`
PIPED_PROXY_IMAGE=1337kavin/piped-proxy@sha256:2ec9f1d16cc24f6f5e8a6dcdb4235e277d10dbac8a5708e2d11dc3535750366f

# bg-helper-server (PoToken provider for the Java backend). Upstream only
# ships :latest, so pinned by amd64 digest instead for reproducibility.
# Re-pin periodically:
# `docker pull 1337kavin/bg-helper-server:latest && docker inspect --format='{{index .RepoDigests 0}}' 1337kavin/bg-helper-server:latest`
PIPED_BG_HELPER_IMAGE=1337kavin/bg-helper-server@sha256:4fcdddf26bd901075ceff1afd0f8112ef3eefc9c774fa9cbb1756e2a34e65be4

# piped-resolver (yt-dlp adaptive resolver). Built locally from ./resolver; this
# tag names the resulting image. No registry push — `make rebuild` builds it.
PIPED_RESOLVER_IMAGE=spoke-piped-resolver:local

# bgutil POT provider for the resolver. Pin must match the resolver's
# bgutil-ytdlp-pot-provider plugin version (resolver/requirements.txt).
PIPED_BGUTIL_IMAGE=brainicism/bgutil-ytdlp-pot-provider:1.3.1

# Module-local Postgres. pgautoupgrade handles major version migrations.
# PG18 baseline matches the Spoke hub convention; image is fully external so the
# module stays standalone (no dependency on hub-built postgres image).
PIPED_POSTGRES_IMAGE=pgautoupgrade/pgautoupgrade:18-alpine

#### NETWORK

PIPED_FRONTEND_IP=192.168.35.26
PIPED_BACKEND_IP=192.168.35.27
PIPED_PROXY_IP=192.168.35.28
PIPED_BG_HELPER_IP=192.168.35.29
PIPED_POSTGRES_IP=192.168.35.30
PIPED_RESOLVER_IP=192.168.35.31
PIPED_BGUTIL_IP=192.168.35.32

#### RESOLVER

# Innertube clients for yt-dlp to pin. Empty = yt-dlp default set (recommended;
# web/web_safari are SABR-only and return no stream URLs).
PIPED_RESOLVER_PLAYER_CLIENTS=
# Public ytproxy base echoed as `proxyUrl` so the Piped frontend can proxy
# thumbnails/streams. Override per-site to the proxy subdomain URL.
PIPED_RESOLVER_PROXY_URL=
# Seconds to cache a /streams result (must stay below googlevideo URL expiry).
PIPED_RESOLVER_CACHE_TTL=3600
PIPED_RESOLVER_SEARCH_LIMIT=20
PIPED_RESOLVER_ALLOWED_ORIGINS=*

#### HOSTNAMES

# Subdomain prefixes are substituted into Traefik routers at deploy time by
# Spoke's deploy_traefik_rules.sh (>= 1.3.0) and into docker-compose.yml at
# compose-read time. Override via modules.yml env_overrides for a custom
# brand (e.g. tube/tubeapi/tubeproxy).
PIPED_FRONTEND_SUBDOMAIN=piped
PIPED_API_SUBDOMAIN=pipedapi
PIPED_PROXY_SUBDOMAIN=pipedproxy

#### POSTGRES

PIPED_POSTGRES_DB=piped
PIPED_POSTGRES_USER=piped

#### DATA PATHS

PIPED_DIR=${APPDATA_DIR}/piped
